module(
    name = "rules_hdl",
    repo_name = "rules_hdl",
)

# Override zlib to use newer version compatible with macOS SDK 26.1
bazel_dep(name = "zlib", version = "1.3.1.bcr.3")

single_version_override(
    module_name = "bazel_features",
    version = "1.30.0",
)

# Core Bazel rules
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "rules_cc", version = "0.2.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_bison", version = "0.3")
bazel_dep(name = "rules_flex", version = "0.3")
bazel_dep(name = "rules_m4", version = "0.3")
# Use repo_name to map old WORKSPACE names to Bzlmod modules for compatibility
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "protobuf", version = "31.1", repo_name = "com_google_protobuf")
bazel_dep(name = "googletest", version = "1.17.0", dev_dependency = True)

# Python support
bazel_dep(name = "rules_python", version = "1.0.0")

# Additional build rules
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "bazel_features", version = "1.30.0")

# Python toolchain configuration
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.9",
    is_default = True,
    ignore_root_user_error = True,
)
use_repo(python, "python_3_9")

# Python dependencies via pip
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "rules_hdl_pip_deps_to_vendor",
    python_version = "3.9",
    requirements_lock = "//dependency_support:pip_requirements.txt",
)
use_repo(pip, "rules_hdl_pip_deps_to_vendor")
