""" Use system-installed readline on macOS """

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["restricted"])  # GPL v3

# Copy readline headers from Homebrew installation
genrule(
    name = "generate_readline_headers",
    outs = [
        "readline/readline.h",
        "readline/history.h",
        "readline/chardefs.h",
        "readline/keymaps.h",
        "readline/rlconf.h",
        "readline/rlstdc.h",
        "readline/rltypedefs.h",
        "readline/tilde.h",
    ],
    cmd = """
        mkdir -p $(@D)/readline
        # Copy headers from Homebrew readline
        cp /opt/homebrew/opt/readline/include/readline/readline.h $(location readline/readline.h)
        cp /opt/homebrew/opt/readline/include/readline/history.h $(location readline/history.h)
        cp /opt/homebrew/opt/readline/include/readline/chardefs.h $(location readline/chardefs.h)
        cp /opt/homebrew/opt/readline/include/readline/keymaps.h $(location readline/keymaps.h)
        cp /opt/homebrew/opt/readline/include/readline/rlconf.h $(location readline/rlconf.h)
        cp /opt/homebrew/opt/readline/include/readline/rlstdc.h $(location readline/rlstdc.h)
        cp /opt/homebrew/opt/readline/include/readline/rltypedefs.h $(location readline/rltypedefs.h)
        # tilde.h might not exist, create a minimal one
        echo '#ifndef _READLINE_TILDE_H_' > $(location readline/tilde.h)
        echo '#define _READLINE_TILDE_H_' >> $(location readline/tilde.h)
        echo '#endif' >> $(location readline/tilde.h)
    """,
)

# This library uses the Homebrew-installed readline
cc_library(
    name = "readline",
    hdrs = [":generate_readline_headers"],
    includes = ["."],
    linkopts = [
        "-L/opt/homebrew/opt/readline/lib",
        "-lreadline",
    ],
)

cc_library(
    name = "prefixed_readline_header",
    hdrs = [":generate_readline_headers"],
    includes = ["."],
)
