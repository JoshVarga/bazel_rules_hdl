""" Use system-installed libffi on macOS (Homebrew) """

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

# Copy libffi headers from Homebrew installation
genrule(
    name = "generate_libffi_headers",
    outs = [
        "ffi.h",
        "ffitarget.h",
    ],
    cmd = """
        # Copy headers from Homebrew libffi
        cp /opt/homebrew/opt/libffi/include/ffi.h $(location ffi.h)
        cp /opt/homebrew/opt/libffi/include/ffitarget.h $(location ffitarget.h)
    """,
)

# This library uses the system-installed libffi from Homebrew
cc_library(
    name = "libffi",
    hdrs = [":generate_libffi_headers"],
    includes = ["."],
    linkopts = [
        "-L/opt/homebrew/opt/libffi/lib",
        "-lffi",
    ],
)
